# --- Local development -------------------------------------------------
# Leave both unset: the app runs on mock data with no backend needed.
# To develop against a local backend on :8000, set only this:
#   VITE_USE_MOCK=false
# (vite proxies /api -> localhost:8000, so VITE_API_BASE_URL stays empty)

# --- Production (set these in Vercel -> Settings -> Environment Variables)
# Full origin of the deployed API, no trailing slash and no /api suffix.
VITE_API_BASE_URL=https://review-intel-api.onrender.com
VITE_USE_MOCK=false
